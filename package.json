{
  "name": "coffee-mail-sdk",
  "version": "0.1.6",
  "private": true,
  "license": "UNLICENSED",
  "description": "Monorepo de SDKs oficiais do CoffeeMail (proprietário)",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "build:node": "pnpm --filter @coffeemail/node build",
    "publish:node": "pnpm --filter @coffeemail/node publish --access public --no-git-checks",
    "check:standards": "turbo run check:standards"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
